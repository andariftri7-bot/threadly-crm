# ==========================================
# THREADLY - Environment Variables Example
# ==========================================

# 1. Supabase Project Configuration
# Diperoleh dari dashboard Supabase: Project Settings -> API
# - Project URL: URL REST/GraphQL endpoint Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# - Project Anon Key: Kunci publik yang aman digunakan di browser (RLS diaktifkan)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# - Service Role Key: Kunci rahasia untuk operasi super admin/server-only (JANGAN bocorkan ke client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 2. Application Base URL
# URL dasar aplikasi (e.g. http://localhost:3000 saat lokal atau https://threadly.id saat produksi)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# 3. LLM AI Assistant Configuration
# Pilihan provider: "openai" atau "gemini" atau "mock" (default jika kosong: aplikasi tetap berjalan normal)
LLM_PROVIDER=openai

# Kunci API untuk LLM (misal: sk-... dari platform.openai.com atau AI Studio untuk Gemini)
# Apabila dibiarkan kosong, Threadly akan menampilkan notifikasi panduan tanpa menimbulkan error.
LLM_API_KEY=your-llm-api-key-here

# 4. Super Admin Dedicated Email
# Satu-satunya akun yang berhak mengakses area super admin /admin & API admin
SUPERADMIN_EMAIL=andariftri7@gmail.com
